# Configuration of the EnvRune Cloud server. Copy to .env.local for local
# development, or set the same three variables in the host (Vercel: Project
# Settings, Environment Variables). Until all three are set, the server shows
# a page saying which are missing.

# The address of your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase's publishable key (sb_publishable_...). It is sent to browsers.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Supabase's secret key (sb_secret_...). Server only: never commit it, and
# never give it the NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
