# Configuration of the EnvRune Cloud server (docker-compose.yml).
# Copy to .env, which Git ignores.

# The address of your Supabase as browsers and this server reach it.
NEXT_PUBLIC_SUPABASE_URL=https://supabase.example.com

# Supabase's public key: the "publishable" key of a hosted project, or
# ANON_KEY of a self-hosted one. It is sent to browsers.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase's server key: the "secret" key of a hosted project, or
# SERVICE_ROLE_KEY of a self-hosted one. It never leaves the server; it
# signs the CLI in and checks machine tokens.
SUPABASE_SECRET_KEY=

# The port on this machine that the reverse proxy forwards to.
ENVRUNE_CLOUD_PORT=3000
