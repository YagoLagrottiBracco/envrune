{
  // Run `envrune unlock` (or `envrune keychain enable`) first: the debugger
  // has no terminal in which to type the master password.
  "version": "0.2.0",
  "configurations": [
    // With the EnvRune extension (packages/vscode), "envrune" adds the
    // variables to any debug configuration, in memory.
    {
      "name": "Node.js (EnvRune extension)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/index.js",
      "envrune": true
    },
    {
      "name": "Python (EnvRune extension, staging)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "envrune": { "env": "staging" }
    },
    // Without the extension, run the program through `envrune run`.
    {
      "name": "Node.js (envrune)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "envrune",
      "runtimeArgs": ["run", "--", "node"],
      "program": "${workspaceFolder}/src/index.js",
      "console": "integratedTerminal"
    },
    {
      "name": "npm run dev (envrune)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "envrune",
      "runtimeArgs": ["run", "--", "npm", "run", "dev"],
      "console": "integratedTerminal"
    },
    {
      "name": "Python attach (envrune)",
      "type": "debugpy",
      "request": "attach",
      "connect": { "host": "127.0.0.1", "port": 5678 },
      "preLaunchTask": "debugpy (envrune)"
    }
  ]
}
